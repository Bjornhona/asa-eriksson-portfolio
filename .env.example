# Absolute site origin, used to build canonical and hreflang URLs in page
# metadata. No trailing slash. If this is unset, those URLs render as
# "undefined/en/contact" — set it locally and in Vercel.
SITE_URL=

# SMTP credentials for the /contact form.
# Zoho: smtp.zoho.eu (or smtp.zoho.com), port 465 for SSL or 587 for STARTTLS.
#
# Copy to .env.local for development and set the same values in Vercel.
# Nothing from the form is stored or logged; these are only used to send.

ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# Where form submissions are delivered. Also used as the From address.
# Zoho rejects any send whose From is not a mailbox on the authenticated
# account, so CONTACT_TO must be a real address on the ZOHO_SMTP_USER account
# (normally the same address). Pointing it at an external forwarding
# address will make every send fail authentication.
CONTACT_TO=
