# SMTP credentials for the /nordic-spain compliance-check request form.
# Zoho: smtp.zoho.eu (or smtp.zoho.com), port 465 for SSL or 587 for STARTTLS.
# SMTP_USER must be a real mailbox on the account — Zoho rejects sends where
# the From address is not the authenticated user.
#
# Copy to .env.local for development and set the same values in Vercel.
# Nothing from the form is stored or logged; these are only used to send.

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Where form submissions are delivered.
CONTACT_TO=
